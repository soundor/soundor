# Run by the soundor_engine_stage target (SoundorEngineStage.cmake):
#   cmake -DINPUTS=<soundor-engine-stage-<config>.cmake> -P SoundorEngineStageFiles.cmake
# Lays out the prebuilt engine in STAGE, from scratch every time.

cmake_minimum_required(VERSION 3.22)
include("${INPUTS}")

if(NOT CONFIG STREQUAL EXPECTED_CONFIG)
  message(FATAL_ERROR "This prebuilt engine is staged from a ${EXPECTED_CONFIG} build, not ${CONFIG}")
endif()

file(REMOVE_RECURSE "${STAGE}")
file(MAKE_DIRECTORY "${STAGE}")

foreach(copy IN LISTS COPIES)
  string(REPLACE "|" ";" pair "${copy}")
  list(GET pair 0 from)
  list(GET pair 1 to)
  if(NOT EXISTS "${from}" OR IS_DIRECTORY "${from}")
    message(FATAL_ERROR "A prebuilt engine file is missing: ${from}")
  endif()
  get_filename_component(directory "${STAGE}/${to}" DIRECTORY)
  file(MAKE_DIRECTORY "${directory}")
  file(COPY_FILE "${from}" "${STAGE}/${to}")
endforeach()

foreach(tree IN LISTS TREES)
  string(REPLACE "|" ";" pair "${tree}")
  list(GET pair 0 from)
  list(GET pair 1 to)
  if(NOT IS_DIRECTORY "${from}")
    message(FATAL_ERROR "A prebuilt engine directory is missing: ${from}")
  endif()
  file(MAKE_DIRECTORY "${STAGE}/${to}")
  file(COPY "${from}/" DESTINATION "${STAGE}/${to}")
endforeach()

# licenses/<component>/: a file as it is named; a directory under its own
# name, or merged when it is named after the component (or "licenses").
foreach(license IN LISTS LICENSES)
  string(REPLACE "|" ";" pair "${license}")
  list(GET pair 0 component)
  list(GET pair 1 from)
  set(to "${STAGE}/licenses/${component}")
  file(MAKE_DIRECTORY "${to}")
  get_filename_component(name "${from}" NAME)
  if(IS_DIRECTORY "${from}")
    if(name STREQUAL component OR name STREQUAL "licenses")
      file(COPY "${from}/" DESTINATION "${to}")
    else()
      file(COPY "${from}" DESTINATION "${to}")
    endif()
  elseif(EXISTS "${from}")
    file(COPY_FILE "${from}" "${to}/${name}")
  else()
    message(FATAL_ERROR "A license notice of the prebuilt engine is missing: ${from}")
  endif()
endforeach()
foreach(component IN LISTS LINKED)
  file(GLOB_RECURSE notices LIST_DIRECTORIES false "${STAGE}/licenses/${component}/*")
  set(nonempty "")
  foreach(notice IN LISTS notices)
    file(SIZE "${notice}" size)
    if(size GREATER 0)
      list(APPEND nonempty "${notice}")
    endif()
  endforeach()
  if(NOT nonempty)
    message(FATAL_ERROR "The prebuilt engine links ${component} but has no license notice for it")
  endif()
endforeach()

file(WRITE "${STAGE}/soundor-engine.json" "${METADATA}")
message(STATUS "Staged the prebuilt engine in ${STAGE}")
