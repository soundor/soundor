{
  "name": "@soundor/engine",
  "version": "0.8.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soundor/soundor.git",
    "directory": "engines/engine"
  },
  "files": [
    "CMakeLists.txt",
    "README.md",
    "LICENSE",
    "cmake",
    "include",
    "src",
    "scripts",
    "artifacts/manifest.json",
    "NOTICE.md",
    "licenses",
    "dist"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./native-module": {
      "types": "./dist/native-module.d.mts",
      "import": "./dist/native-module.mjs"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    }
  },
  "scripts": {
    "format:native": "node ../../scripts/clang-format.mjs --check include src tests wasm",
    "format:native:fix": "node ../../scripts/clang-format.mjs --fix include src tests wasm",
    "lint:native": "cmake --workflow --preset tidy",
    "test": "node --test tests/tooling/*.test.mjs",
    "test:native": "cmake --workflow --preset dev",
    "build": "tsc -p tsconfig.node.json && tsc -p web/tsconfig.json && tsc -p web/tsconfig.test.json && tsdown --clean",
    "build:wasm": "node web/scripts/build-wasm.ts",
    "test:wasm": "vitest run --config web/vitest.config.ts",
    "test:browser": "vitest run --config web/vitest.browser.config.ts",
    "fixture": "vite --config web/fixture/vite.config.ts",
    "bench:wasm": "node web/scripts/bench.ts"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-transform-async-generator-functions": "catalog:",
    "@babel/plugin-transform-async-to-generator": "catalog:",
    "@babel/plugin-transform-block-scoping": "catalog:",
    "@babel/plugin-transform-class-properties": "catalog:",
    "@babel/plugin-transform-class-static-block": "catalog:",
    "@babel/plugin-transform-classes": "catalog:",
    "@babel/plugin-transform-dynamic-import": "catalog:",
    "@babel/plugin-transform-modules-commonjs": "catalog:",
    "@babel/plugin-transform-private-methods": "catalog:",
    "@babel/plugin-transform-private-property-in-object": "catalog:",
    "@playwright/test": "catalog:",
    "@soundor/tsdown-config": "workspace:^",
    "@soundor/typescript-config": "workspace:^",
    "@types/node": "catalog:",
    "three": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
