{
  "extends": "@soundor/typescript-config/node",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Runs in the browser and in Node: WebAssembly and atob, from the DOM's.
    "lib": ["es2023", "DOM"],
