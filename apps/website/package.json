{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "description": "soundor.dev: the Soundor documentation website",
  "type": "module",
  "scripts": {
    "build": "node scripts/sync-examples.ts && node scripts/build-playground.ts && vite build && node scripts/check-links.ts && tsc --noEmit",
