  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@soundor/config": "workspace:*",
    "@soundor/core": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/three": "catalog:",
    "rolldown": "catalog:",
    "soundor": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
