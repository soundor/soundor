{
  "name": "@soundor/core",
  "version": "0.7.0",
  "license": "MIT",
  "files": [
    "README.md",
    "dist",
    "runtime"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./runtime/globals.d.ts": "./runtime/globals.d.ts",
    "./runtime/ui.d.ts": "./runtime/ui.d.ts",
    "./spring": {
      "types": "./dist/spring.d.mts",
      "import": "./dist/spring.mjs"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown --clean",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "gen:runtime-types": "node scripts/runtime-types.mjs"
  },
  "dependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-transform-async-generator-functions": "catalog:",
    "@babel/plugin-transform-async-to-generator": "catalog:",
    "@babel/plugin-transform-block-scoping": "catalog:",
    "@babel/plugin-transform-class-properties": "catalog:",
    "@babel/plugin-transform-class-static-block": "catalog:",
    "@babel/plugin-transform-classes": "catalog:",
    "@babel/plugin-transform-dynamic-import": "catalog:",
    "@babel/plugin-transform-modules-commonjs": "catalog:",
    "@babel/plugin-transform-private-methods": "catalog:",
    "@babel/plugin-transform-private-property-in-object": "catalog:"
  },
  "devDependencies": {
    "@soundor/tsdown-config": "workspace:^",
    "@soundor/typescript-config": "workspace:^",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
