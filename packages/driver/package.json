{
  "name": "@soundor/driver",
  "version": "0.18.0",
  "description": "Inspect and control a running Soundor plugin's native UI through its DevTools session.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soundor/soundor.git",
    "directory": "packages/driver"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vst3": {
      "types": "./dist/vst3.d.ts",
      "import": "./dist/vst3.js"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@soundor/devtools-protocol": "workspace:^",
    "@soundor/devtools-server": "workspace:^",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@soundor/tsdown-config": "workspace:^",
    "@soundor/typescript-config": "workspace:^",
    "@soundor/vst3-host": "workspace:^",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@soundor/vst3-host": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@soundor/vst3-host": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
