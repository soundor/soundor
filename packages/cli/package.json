{
  "name": "soundor",
  "version": "0.12.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soundor/soundor.git",
    "directory": "packages/cli"
  },
  "bin": {
    "soundor": "./dist/index.mjs"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -b && tsdown --clean",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:devtools-consumer": "node scripts/devtools-consumer-smoke.mjs"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@soundor/devtools-client": "workspace:^",
    "@soundor/devtools-server": "workspace:^",
    "@soundor/driver": "workspace:^",
    "citty": "catalog:",
    "tsdown": "catalog:"
  },
  "devDependencies": {
    "@soundor/config": "workspace:^",
    "@soundor/core": "workspace:^",
    "@soundor/devtools-protocol": "workspace:^",
    "@soundor/tsdown-config": "workspace:^",
    "@soundor/typescript-config": "workspace:^",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@soundor/config": "workspace:>=0.0.0 <1.0.0",
    "@soundor/core": "workspace:>=0.0.0 <1.0.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
