{
  "name": "vitest-environment-soundor",
  "version": "0.13.0",
  "description": "Simulated Soundor environment for Vitest",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soundor/soundor.git",
    "directory": "packages/vitest-environment-soundor"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown --clean",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@soundor/test-runtime": "workspace:^"
  },
  "devDependencies": {
    "@soundor/tsdown-config": "workspace:^",
    "@soundor/typescript-config": "workspace:^",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vitest": "^5.0.3"
  }
}
