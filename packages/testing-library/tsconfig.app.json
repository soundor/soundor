{
  "extends": "@soundor/typescript-config/node",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["es2023"],
    // types replaces the preset's ["node"]: keep it, add Soundor's environment.
    "types": ["node", "@soundor/environment"],
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test-contract.d.ts"]
}
