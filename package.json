{
  "name": "soundor-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=!./examples/*",
    "changeset": "changeset",
    "check": "pnpm run format && pnpm run lint && pnpm run build && pnpm run test",
    "ci:publish": "changeset publish",
    "dev": "turbo run dev --filter=!./examples/*",
    "format": "turbo run //#format:check format:native",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt . && turbo run format:native:fix",
    "lint": "turbo run //#lint:check lint:native",
    "lint:check": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "husky",
    "release": "pnpm build && pnpm ci:publish",
    "test": "turbo run test test:native --filter=!./examples/*",
    "test:watch": "turbo run dev test:watch --parallel --filter=!./examples/*",
    "version": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:"
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
