{
  "name": "soundor-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=!./examples/*",
    "changeset": "changeset",
    "ci:publish": "changeset publish",
    "dev": "turbo run dev --filter=!./examples/*",
    "format": "turbo run //#format:check",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt .",
    "lint": "turbo run //#lint:check",
    "lint:check": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "husky",
    "release": "pnpm build && pnpm ci:publish",
    "test": "turbo run test --filter=!./examples/*",
    "test:watch": "turbo run dev test:watch --parallel --filter=!./examples/*",
    "version": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:"
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
