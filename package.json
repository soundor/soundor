{
  "name": "soundor-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=!./apps/* --filter=!./examples/* --filter=!./tools/*",
    "changeset": "changeset",
    "check": "pnpm run format && pnpm run lint && pnpm run build && pnpm run test",
    "ci:publish": "changeset publish",
    "dev": "turbo run dev --filter=!./apps/* --filter=!./examples/* --filter=!./tools/*",
    "format": "turbo run //#format:check format:native",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt . && turbo run format:native:fix",
    "lint": "turbo run //#lint:check lint:native",
    "lint:check": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "husky",
    "release": "pnpm build && pnpm ci:publish",
    "test": "turbo run test test:native --filter=!./examples/* --filter=!./tools/* --filter=!@soundor/react-tests",
    "test:watch": "turbo run dev test:watch --parallel --filter=!./examples/* --filter=!./tools/* --filter=!@soundor/react-tests",
    "version": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:"
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
