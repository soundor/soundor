{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug build with tests",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SOUNDOR_BUILD_TESTS": "ON",
        "SOUNDOR_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "sanitize",
      "inherits": "dev",
      "displayName": "Debug build with ASan + UBSan",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": { "SOUNDOR_ENABLE_SANITIZERS": "ON" }
    },
    {
      "name": "tidy",
      "inherits": "dev",
      "displayName": "Debug build checked by clang-tidy",
      "binaryDir": "${sourceDir}/build/tidy",
      "cacheVariables": { "SOUNDOR_ENABLE_CLANG_TIDY": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev", "configuration": "Debug" },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "configuration": "Debug"
    },
    { "name": "tidy", "configurePreset": "tidy", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "sanitize",
      "steps": [
        { "type": "configure", "name": "sanitize" },
        { "type": "build", "name": "sanitize" },
        { "type": "test", "name": "sanitize" }
      ]
    },
    {
      "name": "tidy",
      "steps": [
        { "type": "configure", "name": "tidy" },
        { "type": "build", "name": "tidy" }
      ]
    }
  ]
}
