{
  "version": 6,
  "configurePresets": [
    {
      "name": "juce",
      "binaryDir": "${sourceDir}/build/engine-juce",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SOUNDOR_BUILD_TESTS": "ON",
        "SOUNDOR_ENABLE_DEVTOOLS": "ON",
        "SOUNDOR_JUCE_TESTS": "ON"
      }
    },
    {
      "name": "tidy",
      "inherits": "juce",
      "binaryDir": "${sourceDir}/build/tidy",
      "cacheVariables": {
        "SOUNDOR_ENGINE_MODE": "prebuilt",
        "SOUNDOR_JUCE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "nogpu",
      "inherits": "juce",
      "binaryDir": "${sourceDir}/build/nogpu",
      "cacheVariables": {
        "SOUNDOR_ENGINE_MODE": "source",
        "SOUNDOR_ENABLE_GPU": "OFF"
      }
    },
    {
      "name": "sanitize",
      "inherits": "juce",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": {
        "SOUNDOR_ENGINE_MODE": "source",
        "SOUNDOR_ENABLE_SANITIZERS": "ON",
        "SOUNDOR_ENGINE_PREBUILT_DEBUG_DIR": "",
        "SOUNDOR_ENGINE_PREBUILT_RELEASE_DIR": ""
      }
    }
  ],
  "buildPresets": [
    {
      "name": "juce",
      "configurePreset": "juce",
      "configuration": "Debug",
      "targets": [
        "soundor_juce_tests",
        "soundor_juce_platform_tests",
        "soundor_juce_state_tests",
        "soundor_debug_target",
        "soundor_juce_editor_resize",
        "soundor_juce_coexistence"
      ]
    },
    {
      "name": "tidy",
      "configurePreset": "tidy",
      "configuration": "Debug",
      "targets": ["soundor_juce_lint"]
    },
    {
      "name": "nogpu",
      "inherits": "juce",
      "configurePreset": "nogpu"
    },
    {
      "name": "sanitize",
      "inherits": "juce",
      "configurePreset": "sanitize",
      "targets": [
        "soundor_juce_tests",
        "soundor_juce_platform_tests",
        "soundor_juce_state_tests",
        "soundor_debug_target"
      ],
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "juce",
      "configurePreset": "juce",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^soundor_(juce_|debug_session$)"
        }
      }
    },
    {
      "name": "nogpu",
      "inherits": "juce",
      "configurePreset": "nogpu"
    },
    {
      "name": "sanitize",
      "inherits": "juce",
      "configurePreset": "sanitize",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "juce",
      "steps": [
        {
          "type": "configure",
          "name": "juce"
        },
        {
          "type": "build",
          "name": "juce"
        },
        {
          "type": "test",
          "name": "juce"
        }
      ]
    },
    {
      "name": "tidy",
      "steps": [
        {
          "type": "configure",
          "name": "tidy"
        },
        {
          "type": "build",
          "name": "tidy"
        }
      ]
    },
    {
      "name": "nogpu",
      "steps": [
        {
          "type": "configure",
          "name": "nogpu"
        },
        {
          "type": "build",
          "name": "nogpu"
        },
        {
          "type": "test",
          "name": "nogpu"
        }
      ]
    },
    {
      "name": "sanitize",
      "steps": [
        {
          "type": "configure",
          "name": "sanitize"
        },
        {
          "type": "build",
          "name": "sanitize"
        },
        {
          "type": "test",
          "name": "sanitize"
        }
      ]
    }
  ]
}
