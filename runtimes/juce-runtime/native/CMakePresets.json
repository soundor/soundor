{
  "version": 6,
  "configurePresets": [
    {
      "name": "juce",
      "binaryDir": "${sourceDir}/build/engine-juce",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SOUNDOR_BUILD_TESTS": "ON",
        "SOUNDOR_ENABLE_DEVTOOLS": "ON",
        "SOUNDOR_JUCE_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "juce",
      "configurePreset": "juce",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "juce",
      "configurePreset": "juce",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "juce",
      "steps": [
        {
          "type": "configure",
          "name": "juce"
        },
        {
          "type": "build",
          "name": "juce"
        },
        {
          "type": "test",
          "name": "juce"
        }
      ]
    }
  ]
}
