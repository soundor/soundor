{
  "name": "@soundor/juce-runtime",
  "version": "0.16.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soundor/soundor.git",
    "directory": "runtimes/juce-runtime"
  },
  "files": [
    "README.md",
    "dist",
    "native/CMakeLists.txt",
    "native/SoundorPluginBundle.cmake",
    "native/SoundorRust.cmake",
    "native/SoundorRustWindows.cmake",
    "native/backend"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown --clean",
    "dev": "tsdown --watch",
    "format:native": "node ../../scripts/clang-format.mjs --check native",
    "format:native:fix": "node ../../scripts/clang-format.mjs --fix native",
    "gen:webgl": "node scripts/webgl-codegen.mjs",
    "lint:native": "cd native && cmake --workflow --preset tidy",
    "test": "vitest run",
    "test:plugin": "soundor init --config tests/plugin/soundor.config.ts && soundor build juce --config tests/plugin/soundor.config.ts",
    "test:plugin:audio": "node tests/plugin/audio.mjs",
    "test:plugin:debug": "soundor init --config tests/plugin/soundor.config.ts && soundor build juce --debug --config tests/plugin/soundor.config.ts",
    "test:watch": "vitest watch",
    "test:rust-link": "node scripts/rust-link.mjs"
  },
  "dependencies": {
    "@soundor/engine": "workspace:*",
    "@soundor/runtime-sdk": "workspace:^"
  },
  "devDependencies": {
    "@soundor/config": "workspace:^",
    "@soundor/tsdown-config": "workspace:^",
    "@soundor/typescript-config": "workspace:^",
    "@soundor/vst3-host": "workspace:^",
    "@types/node": "catalog:",
    "soundor": "workspace:^",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@soundor/vst3-host": "workspace:^",
    "soundor": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@soundor/vst3-host": {
      "optional": true
    }
  }
}
