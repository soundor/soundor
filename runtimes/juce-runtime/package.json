{
  "name": "@soundor/juce-runtime",
  "version": "0.11.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soundor/soundor.git",
    "directory": "runtimes/juce-runtime"
  },
  "files": [
    "README.md",
    "dist",
    "native/CMakeLists.txt",
    "native/SoundorPluginBundle.cmake",
    "native/backend"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown --clean",
    "dev": "tsdown --watch",
    "format:native": "node ../../scripts/clang-format.mjs --check native",
    "gen:webgl": "node scripts/webgl-codegen.mjs",
    "format:native:fix": "node ../../scripts/clang-format.mjs --fix native",
    "lint:native": "node ../../scripts/clang-format.mjs --check native",
    "test": "vitest run",
    "test:plugin": "soundor init --config tests/plugin/soundor.config.ts && soundor build juce --config tests/plugin/soundor.config.ts",
    "test:plugin-prebuilt": "soundor init --config tests/plugin-prebuilt/soundor.config.ts && soundor build juce --config tests/plugin-prebuilt/soundor.config.ts",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@soundor/engine": "workspace:*"
  },
  "devDependencies": {
    "@soundor/config": "workspace:^",
    "@soundor/core": "workspace:^",
    "@soundor/runtime-sdk": "workspace:^",
    "@soundor/tsdown-config": "workspace:^",
    "@soundor/typescript-config": "workspace:^",
    "@types/node": "catalog:",
    "soundor": "workspace:^",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@soundor/config": "workspace:>=0.0.0 <1.0.0",
    "@soundor/core": "workspace:>=0.0.0 <1.0.0"
  }
}
