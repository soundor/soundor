{
  "name": "@soundor/juce-runtime",
  "version": "0.2.0",
  "license": "MIT",
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown --clean",
    "dev": "tsdown --watch",
    "format:native": "node ../../scripts/clang-format.mjs --check native",
    "format:native:fix": "node ../../scripts/clang-format.mjs --fix native",
    "lint:native": "cd native && cmake --workflow --preset tidy",
    "test": "vitest run",
    "test:native": "cd native && cmake --workflow --preset dev",
    "test:watch": "vitest watch"
  },
  "devDependencies": {
    "@soundor/bridge": "workspace:^",
    "@soundor/config": "workspace:^",
    "@soundor/core": "workspace:^",
    "@soundor/runtime-sdk": "workspace:^",
    "@soundor/tsdown-config": "workspace:^",
    "@soundor/typescript-config": "workspace:^",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@soundor/bridge": "workspace:>=0.0.0 <1.0.0",
    "@soundor/config": "workspace:>=0.0.0 <1.0.0",
    "@soundor/core": "workspace:>=0.0.0 <1.0.0"
  }
}
