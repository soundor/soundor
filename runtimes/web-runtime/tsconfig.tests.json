{
  "extends": "@soundor/typescript-config/node-test",
  "compilerOptions": {
    // The host UI is Preact.
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["es2023", "DOM", "DOM.Iterable"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    // soundor:ui alone: its globals would clash with the DOM's.
    "types": ["node", "@soundor/environment/ui.d.ts"],
    // The generated native.ts fixture imports the package's client entry.
    "paths": {
      "@soundor/web-runtime/client": ["./src/client/index.ts"]
    }
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/client/testing/*.d.ts",
    "src/client/testing/native.ts",
    "src/client/internal.d.ts"
  ]
}
