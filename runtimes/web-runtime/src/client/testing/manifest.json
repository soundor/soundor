{
  "plugin": {
    "id": "com.example.fixture",
    "name": "Fixture"
  },
  "parameters": [
    {
      "id": "gain",
      "label": "Gain",
      "type": "float",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "unit": "dB"
    },
    {
      "id": "steps",
      "label": "Steps",
      "type": "int",
      "min": 1,
      "max": 8,
      "default": 4
    },
    {
      "id": "bypass",
      "label": "Bypass",
      "type": "bool",
      "default": false
    },
    {
      "id": "mode",
      "label": "Mode",
      "type": "enum",
      "values": [
        "clean",
        "warm",
        "hot"
      ],
      "default": "warm"
    }
  ],
  "native": {
    "methods": [
      {
        "name": "analyze",
        "async": false
      },
      {
        "name": "echo",
        "async": false
      },
      {
        "name": "fail",
        "async": false
      },
      {
        "name": "failLater",
        "async": true
      },
      {
        "name": "invert",
        "async": false
      },
      {
        "name": "loadPreset",
        "async": true
      },
      {
        "name": "presetName",
        "async": false
      },
      {
        "name": "scale",
        "async": false
      },
      {
        "name": "setCurve",
        "async": false
      }
    ]
  }
}
