{
  "name": "@soundor/vst3-runtime",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soundor/soundor.git",
    "directory": "runtimes/vst3-runtime"
  },
  "files": [
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "dist",
    "rust/Cargo.toml",
    "rust/src",
    "native/CMakeLists.txt",
    "native/cmake",
    "native/include",
    "native/src",
    "artifacts/manifest.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown --clean",
    "build:native": "node scripts/adapter.ts build",
    "dev": "tsdown --watch",
    "format:native": "node ../../scripts/clang-format.mjs --check native",
    "format:native:fix": "node ../../scripts/clang-format.mjs --fix native",
    "gen:expression": "node scripts/expression-runtime.mjs && UPDATE_GOLDEN=1 vitest run src/expression-corpus.test.ts",
    "lint:native": "node scripts/adapter.ts tidy",
    "lint:rust": "cargo fmt --check --manifest-path rust/Cargo.toml && cargo clippy --all-targets --manifest-path rust/Cargo.toml -- -D warnings",
    "test": "vitest run",
    "test:native": "node scripts/adapter.ts test",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml",
    "test:plugin": "soundor build vst3 --config tests/plugin/soundor.config.ts && vitest run --config vitest.plugin.config.ts",
    "test:watch": "vitest watch",
    "test:plugin:run": "vitest run --config vitest.plugin.config.ts"
  },
  "dependencies": {
    "@soundor/engine": "workspace:*",
    "@soundor/runtime-sdk": "workspace:^"
  },
  "devDependencies": {
    "@soundor/config": "workspace:^",
    "@soundor/tsdown-config": "workspace:^",
    "@soundor/typescript-config": "workspace:^",
    "@soundor/vst3-host": "workspace:^",
    "@types/node": "catalog:",
    "soundor": "workspace:^",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@soundor/vst3-host": "workspace:^",
    "soundor": "workspace:^"
  }
}
