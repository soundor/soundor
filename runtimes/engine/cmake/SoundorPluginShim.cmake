include_guard(GLOBAL)
# A source file in each final image, never in the reusable engine archive.
function(soundor_attach_plugin_shim target)
  if(NOT APPLE)
    return()
  endif()
  get_target_property(attached ${target} SOUNDOR_SHIM_ATTACHED)
  if(attached)
    return()
  endif()
  set_target_properties(${target} PROPERTIES SOUNDOR_SHIM_ATTACHED TRUE)
  string(RANDOM LENGTH 32 ALPHABET 0123456789abcdef build_id)
  string(MAKE_C_IDENTIFIER "${target}_${build_id}" identity)
  set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
  target_sources(${target} PRIVATE "${root}/src/a11y/apple/PluginShim.mm")
  target_include_directories(${target} PRIVATE "${root}/src")
  target_compile_definitions(${target} PRIVATE SOUNDOR_PLUGIN_BINARY_ID="${identity}")
  set_target_properties(${target} PROPERTIES OBJCXX_STANDARD 20 OBJCXX_VISIBILITY_PRESET hidden)
  target_compile_options(${target} PRIVATE $<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>)
endfunction()
