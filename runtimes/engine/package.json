{
  "name": "@soundor/engine",
  "version": "0.1.0",
  "license": "MIT",
  "files": [
    "CMakeLists.txt",
    "README.md",
    "LICENSE",
    "cmake",
    "include",
    "src",
    "scripts",
    "artifacts/manifest.json",
    "NOTICE.md"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "format:native": "node ../../scripts/clang-format.mjs --check include src tests",
    "format:native:fix": "node ../../scripts/clang-format.mjs --fix include src tests",
    "lint:native": "cmake --workflow --preset tidy",
    "test:native": "cmake --workflow --preset dev"
  },
  "devDependencies": {
    "@soundor/core": "workspace:^"
  },
  "peerDependencies": {
    "@soundor/core": "workspace:>=0.0.0 <1.0.0"
  }
}
