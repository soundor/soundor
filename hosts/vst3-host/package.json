{
  "name": "@soundor/vst3-host",
  "version": "0.1.2",
  "description": "A standalone VST3 host for tests and development: a native executable driven from Node.js, with or without the plugin's editor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soundor/soundor.git",
    "directory": "hosts/vst3-host"
  },
  "bin": {
    "soundor-vst3-host": "./dist/cli.mjs"
  },
  "files": [
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CMakeLists.txt",
    "CMakePresets.json",
    "protocol.json",
    "targets.json",
    "cmake",
    "native/src",
    "native/tools",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown --clean",
    "test": "vitest run",
    "build:native": "node src/cli.ts prepare --mode source",
    "test:native": "node scripts/native.ts test",
    "tidy:native": "cmake --workflow --preset tidy",
    "format:native": "node ../../scripts/clang-format.mjs --check native",
    "format:native:fix": "node ../../scripts/clang-format.mjs --fix native"
  },
  "devDependencies": {
    "@soundor/tsdown-config": "workspace:^",
    "@soundor/typescript-config": "workspace:^",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
