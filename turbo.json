{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".nvmrc",
    ".clang-format",
    ".clang-tidy",
    "scripts/**"
  ],
  "tasks": {
    "//#format:check": {},
    "//#lint:check": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist"]
    },
    "build:web": {
      "dependsOn": ["^build"],
      "outputs": [".soundor/dist/web/**", ".soundor/generated/**"]
    },
    "website#build": {
      "dependsOn": ["^build:web"],
      "outputs": ["dist/**", "public/examples/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "website#dev": {
      "dependsOn": ["^build:web"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test", "^build"]
    },
    "website#test": {
      "dependsOn": []
    },
    "test:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "format:native": {
      "env": ["CLANG_FORMAT"],
      "passThroughEnv": ["CI"]
    },
    "format:native:fix": {
      "cache": false,
      "env": ["CLANG_FORMAT"]
    },
    "lint:native": {
      "env": ["CC", "CXX", "CFLAGS", "CXXFLAGS", "LDFLAGS", "CMAKE_GENERATOR"],
      "passThroughEnv": [
        "CI",
        "SOUNDOR_CACHE",
        "CMAKE_C_COMPILER_LAUNCHER",
        "CMAKE_CXX_COMPILER_LAUNCHER",
        "CMAKE_BUILD_PARALLEL_LEVEL",
        "CCACHE_*",
        "SOUNDOR_CLANG_TIDY_CACHE"
      ]
    },
    "test:native": {
      "env": ["CC", "CXX", "CFLAGS", "CXXFLAGS", "LDFLAGS", "CMAKE_GENERATOR"],
      "passThroughEnv": [
        "CI",
        "SOUNDOR_CACHE",
        "CMAKE_C_COMPILER_LAUNCHER",
        "CMAKE_CXX_COMPILER_LAUNCHER",
        "CMAKE_BUILD_PARALLEL_LEVEL",
        "CCACHE_*",
        "SOUNDOR_REQUIRE_GPU"
      ]
    }
  }
}
