{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "RUSTUP_HOME",
    "CARGO_HOME",
    "XDG_CACHE_HOME",
    "LOCALAPPDATA"
  ],
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".nvmrc",
    ".clang-format",
    ".clang-tidy",
    "scripts/**"
  ],
  "tasks": {
    "//#format:check": {},
    "//#lint:check": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist"]
    },
    "@soundor/engine#build:wasm": {
      "inputs": [
        "wasm/**",
        "src/**",
        "include/**",
        "cmake/**",
        "licenses/yoga/**",
        "CMakeLists.txt",
        "CMakePresets.json",
        "LICENSE",
        "NOTICE.md",
        "web/scripts/build-wasm.ts",
        "web/src/protocol.ts",
        "node/src/**",
        "scripts/engine-inputs.mjs"
      ],
      "env": ["SOUNDOR_EMSDK_VERSION", "SOUNDOR_ENGINE_SOURCE_COMMIT"],
      "passThroughEnv": [
        "EMSDK",
        "EMSDK_NODE",
        "EM_CONFIG",
        "EM_CACHE",
        "SOUNDOR_CACHE"
      ],
      "outputs": ["build/wasm/web/soundor-core.wasm", "build/wasm/stage/**"]
    },
    "@soundor/engine#test": {
      "dependsOn": ["^test", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/scripts/engine-prebuilts.mjs"
      ]
    },
    "@soundor/web-runtime#test": {
      "dependsOn": ["^test", "^build"],
      "env": ["SOUNDOR_ENGINE_WASM", "SOUNDOR_ENGINE_MANIFEST"],
      "passThroughEnv": [
        "EMSDK",
        "EMSDK_NODE",
        "EM_CONFIG",
        "EM_CACHE",
        "SOUNDOR_CACHE"
      ]
    },
    "build:web": {
      "dependsOn": ["^build"],
      "env": ["SOUNDOR_ENGINE_WASM", "SOUNDOR_ENGINE_MANIFEST"],
      "passThroughEnv": [
        "EMSDK",
        "EMSDK_NODE",
        "EM_CONFIG",
        "EM_CACHE",
        "SOUNDOR_CACHE"
      ],
      "outputs": [".soundor/dist/web/**", ".soundor/generated/**"]
    },
    "website#build": {
      "dependsOn": [
        "^build:web",
        "@soundor/react#build",
        "@soundor/web-runtime#build"
      ],
      "outputs": ["dist/**", "public/examples/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "website#dev": {
      "dependsOn": [
        "^build:web",
        "@soundor/react#build",
        "@soundor/web-runtime#build"
      ],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test", "^build"]
    },
    "website#test": {
      "dependsOn": []
    },
    "test:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "format:native": {
      "env": ["CLANG_FORMAT"],
      "passThroughEnv": ["CI"]
    },
    "format:native:fix": {
      "cache": false,
      "env": ["CLANG_FORMAT"]
    },
    "lint:native": {
      "env": ["CC", "CXX", "CFLAGS", "CXXFLAGS", "LDFLAGS", "CMAKE_GENERATOR"],
      "passThroughEnv": [
        "CI",
        "SOUNDOR_CACHE",
        "CMAKE_C_COMPILER_LAUNCHER",
        "CMAKE_CXX_COMPILER_LAUNCHER",
        "CMAKE_BUILD_PARALLEL_LEVEL",
        "CCACHE_*",
        "SOUNDOR_CLANG_TIDY_CACHE"
      ]
    },
    "test:native": {
      "env": ["CC", "CXX", "CFLAGS", "CXXFLAGS", "LDFLAGS", "CMAKE_GENERATOR"],
      "passThroughEnv": [
        "CI",
        "SOUNDOR_CACHE",
        "CMAKE_C_COMPILER_LAUNCHER",
        "CMAKE_CXX_COMPILER_LAUNCHER",
        "CMAKE_BUILD_PARALLEL_LEVEL",
        "CCACHE_*",
        "SOUNDOR_REQUIRE_GPU"
      ]
    }
  }
}
