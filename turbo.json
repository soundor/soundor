{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "globalDependencies": [
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".clang-format",
    ".clang-tidy",
    "scripts/**"
  ],
  "tasks": {
    "//#format:check": {},
    "//#lint:check": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test", "^build"]
    },
    "test:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "format:native": {
      "env": ["CLANG_FORMAT"],
      "passThroughEnv": ["CI"]
    },
    "format:native:fix": {
      "cache": false,
      "env": ["CLANG_FORMAT"]
    },
    "lint:native": {
      "env": ["CC", "CXX", "CFLAGS", "CXXFLAGS", "LDFLAGS", "CMAKE_GENERATOR"],
      "passThroughEnv": ["CI", "SOUNDOR_CACHE"]
    },
    "test:native": {
      "env": ["CC", "CXX", "CFLAGS", "CXXFLAGS", "LDFLAGS", "CMAKE_GENERATOR"],
      "passThroughEnv": ["CI", "SOUNDOR_CACHE"]
    }
  }
}
