{
  "name": "orbit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "soundor build",
    "build:juce": "soundor build juce",
    "build:web": "soundor build web",
    "dev": "soundor dev juce",
    "dev:web": "soundor dev web",
    "doctor": "soundor doctor",
    "gen": "soundor gen",
    "test": "vitest run --project integration",
    "test:e2e": "soundor build juce --debug && soundor gen && vitest run --project e2e",
    "test:rust": "soundor gen && cargo test --manifest-path native/Cargo.toml",
    "test:watch": "vitest watch --project integration",
    "typecheck": "soundor gen && tsc -b"
  },
  "dependencies": {
    "@soundor/juce-runtime": "workspace:*",
    "@soundor/react": "workspace:*",
    "@soundor/web-runtime": "workspace:*",
    "react": "catalog:"
  },
  "devDependencies": {
    "@soundor/config": "workspace:*",
    "@soundor/testing-library": "workspace:^",
    "@soundor/vitest": "workspace:^",
    "@soundor/vitest-e2e": "workspace:^",
    "@soundor/vst3-host": "workspace:^",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "soundor": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-environment-soundor": "workspace:^"
  }
}
